.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.pianobot/
*.mid
build/
dist/

# Downloaded Vamp plugin binaries for the Docker build -- see
# vamp-plugins/README.md. The README itself is tracked.
vamp-plugins/*
!vamp-plugins/README.md

# Generated by visualizer/*.py (the .blend scene, rendered stills/
# frames/video, synthesized audio) -- only the scripts themselves and
# their README are tracked.
visualizer/*.blend
visualizer/*.blend1
visualizer/*.png
visualizer/*.mp4
visualizer/*.wav
visualizer/*.aac
visualizer/frames/
